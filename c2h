#!/bin/dash
TMPF="$(mktemp)"
FTMPF="$(mktemp)"
FDCLS="$(mktemp)"
NEW_STATIC_DECL="$(mktemp)"
FST_SORTED="$(mktemp)"
SND_SORTED="$(mktemp)"
old_tty_sets="$(stty -g)"
trap 'stty "$old_tty_sets"; rm -f "$TMPF" "$FTMPF" "$FDCLS" "$NEW_STATIC_DECL" "$FST_SORTED" "$SND_SORTED"' EXIT
stty -onlret
gen_header_stamp () {
	fh="$(echo "${1##*/}" | tr '[a-z]' '[A-Z]')_H"
	echo "#ifndef ${fh}" > "$2"
	echo "#define ${fh}" >> "$2"
	printf "/* GENERATED BY \`%s', DO NOT CHANGE FILE */\n\n" "${0##*/}" >> "$2"
}
build_header_types () {
	LC_ALL=C awk '{
		if (NR == 1) {
			state = 0
			brn = 0
		}
		if (/^struct/ || /^enum/ || /^union/ || /^typedef/) {
			state = 1
		}
		if (state == 1 && /{/) {
			brn++
		}
		if (state == 1) {
			record[i++] = $0
		}
		if (state == 1 && /}/) {
			brn--
		}
		if (!/[][]/ && /^}[a-zA-Z0-9$@_ ]*;/ && brn == 0) {
			for (k = 0; k < i; ++k) {
				printf "%s\n", record[k]
			}
			printf "\n"
			state = 0
			i = 0
		}
		if (brn == 0) {
			state = 0
			i = 0
		}
	}' "$1" >> "$2"
}

get_func_prototype ()
{
	if [ "$1" = static ]; then
		cond="~"
	else
		cond="!~"
	fi
	LC_ALL=C awk '{
		if (/^[a-zA-Z_][a-zA-Z0-9_]*\(/ && !/^main/) {
			if (type[(i + 1) % 2] '"$cond"'/static/) {
				state = 1
				n = 0
				record[n++] = type[(i + 1) % 2]
			}
			brn = 0
		}
		if (state == 1 && /\(/) {
			brn++
		}
		if (state == 1 && brn > 0) {
			record[n++] = $0
		}
		if (state == 1 && /\)/) {
			brn--
		}
		if (/{/ && state == 1 && brn == 0) {
			printf "%s ~%s", record[0], record[1] 
			for (k = 2; k < n; ++k) {
				printf "%s", record[k]
			}
			printf ";\n"
			n = 0
			state = 0
		}
		type[i % 2] = $0
		++i
	}' "$FTMPF" | \
	LC_ALL=C sed -e 's/(\(\*\**\)[a-zA-Z0-9$@_]*)/(\1)/g' \
	    -e 's/[[:blank:]]*\(\*\**\)[[:blank:]]*~/~\1/g' \
	    -e 's/\([a-zA-Z0-9@$_][a-zA-Z0-9@$_]*\)\(\**\)[[:blank:]]*\(\**\)[a-zA-Z0-9@$_]*\([,)]\)/\1 \2\3\4/g' \
	    -e 's/\([a-zA-Z0-9@$_]*\)[[:blank:]]*\([,)]\)/\1\2/g' \
	    -e 's/,[[:blank:]]*\([a-zA-Z0-9$@_]\)/, \1/g' \
	    -e 's/\*[a-zA-Z0-9_$]*\[\]/**/g' \
	    -e 's/^\([a-zA-Z0-9@$_ ]*\)\([*(]*\)[[:blank:]]*\(~*\)\([a-zA-Z@$_()* ;]\)/\1\3\2\4/g' | \
	LC_ALL=C awk -F'~' '{ printf "%-24s %s\n", $1, $2 }' >> "$TMPF"
}

get_last_macro_line ()
{
	line="$(awk '{
		if (/^$/) {
			in_macr = 0
		}
		if (/\\/ && in_macr == 2) {
			last++
		}
		if (!/\\$/ && in_macr == 2) {
			in_macr = 0
			last++
		}
		if (/#[a-zA-Z0-9][a-zA-Z0-9]*/) {
			last = NR
			in_macr = 2
		}
		if (in_macr == 0 && /^[a-zA-Z0-9][a-zA-Z0-9]*/) {
			exit
		}
	} END {
		printf "%d", last
	}' "$1.c")"
}

get_func_declaration_static ()
{
	awk '{
		if (/^static/ && /);/) {
			print $0
		}
	} END { 
		printf "\n"
	}' "$1.c" > "$FDCLS"
}

if [ -n "$1" ]; then
	if [ "$1" = "-t" ]; then
		if [ -n "$2" ]; then
			gen_header_stamp "$2" "$TMPF"
			build_header_types "$2.c" "$TMPF"
			mv "$TMPF" "$2_types.h"
			printf "\n#endif /* %s */\n" "${fh}" >> "$2_types.h"
			exit 0
		else
			printf "ERROR: no second argument"
			exit 1
		fi
	elif [ -f "$1.h" ]; then
		printf "FILE: $1.h, already exists\n"
		printf "Would you like to overwrite it: [Y/n] "
		while true; do
			read answer
			case "$answer" in
			Y)
				echo "Proceeding with overwrite..."
				gen_header_stamp "$1" "$TMPF"
				build_header_types "$1.h" "$TMPF"
				break
				;;
			n)
				exit 1
				;;
			*)
				printf "\033[A\r\033[K"
				printf "Would you like to over write it: "
				printf "[Y/n] "
				;;
			esac
		done
	else
		gen_header_stamp "$1" "$TMPF"
	fi
fi
LC_ALL=C awk '/\/\*/, /\*\// { next } { print $0 }' "$1.c" > "$FTMPF"
get_func_prototype func
mv "$TMPF" "$1.h"
printf "\n#endif /* %s */\n" "${fh}" >> "$1.h"

get_last_macro_line "$1"
: ${line:=-1}
if [ -n "$line" ] && [ "$line" != "-1" ]; then
	> "$TMPF"
	get_func_prototype static
	get_func_declaration_static "$1"
	sort "$FDCLS" > "$FST_SORTED"
	sort "$TMPF" > "$SND_SORTED"
	comm -13 "$FST_SORTED" "$SND_SORTED" > "$NEW_STATIC_DECL"
	if [ -n "$NEW_STATIC_DECL" ]; then
		line="$((line + 1))"
		sed "${line}r $NEW_STATIC_DECL" "$1.c" > "$TMPF"
		mv "$TMPF" "$1.c"
	fi
fi

echo "Done"
