#!/bin/dash
awk '{ 
	if (line == 0) {
		line = NR
	}
	if (line == NR) {
		word[i % 2 + 1] = $0
		++i
	} 
	if (/^'"$1"'/) { 
		state = 1;
		s = 1
	} else line++
	if (/^}/ && state == 1) {
		print $0
		state = 0
	}
	if (state) {
		if (s) {
			if (i % 2 == 0) {
				printf "%s\n", word[1]
			} else {
				printf "%s\n", word[2]
			}
			s = 0;
		}
		print $0
	}
     }' "$2.c"
